# --- Azure OpenAI / Microsoft Foundry ---
AZURE_OPENAI_ENDPOINT=https://<votre-ressource>.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o          # nom du déploiement du modèle "fort"
AZURE_OPENAI_CHAT_DEPLOYMENT_LIGHT=gpt-4o-mini  # modèle "léger" pour extraction
AZURE_OPENAI_API_VERSION=2024-10-21
# En local, l'auth passe par `az login` (AzureCliCredential). Pas de clé en clair.

# --- Azure AI Search (base de connaissances RAG, mode déployé) ---
AZURE_AI_SEARCH_ENDPOINT=https://<votre-search>.search.windows.net
AZURE_AI_SEARCH_INDEX=incident-kb
# Clé via Key Vault / Managed Identity en prod ; ne pas committer de clé.

# --- Azure Cosmos DB (persistance, optionnel pour la démo) ---
COSMOS_ENDPOINT=
COSMOS_DATABASE=incidents
COSMOS_CONTAINER=records

# --- Observabilité ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Paramètres d'orchestration ---
CONFIDENCE_THRESHOLD=0.75    # sous ce seuil, l'orchestrateur reboucle
MAX_REFLECTION_LOOPS=2       # nombre maximum de reboucles (borne anti-boucle infinie)
KB_MODE=local                # "local" (knowledge_base.json) ou "azure_search"
